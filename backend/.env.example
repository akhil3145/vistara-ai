# Copy to backend/.env and adjust as needed. Never commit the real .env file.
VISTARA_ENVIRONMENT=development
VISTARA_DEBUG=false

# SQLite database location (relative paths resolve against backend/).
VISTARA_DATABASE_PATH=data/vistara.db
VISTARA_DATABASE_BUSY_TIMEOUT_SECONDS=5.0

# Planned model artifact bundle directory (not loaded in Phase 4).
VISTARA_MODEL_ARTIFACTS_DIR=model_artifacts
# VISTARA_MODEL_VERSION=

# Upload validation limits (frontend currently enforces the same defaults).
VISTARA_MAX_UPLOAD_SIZE_BYTES=10485760
VISTARA_MAX_BATCH_FILES=24

# Vite dev server origins. Comma-separated values are accepted.
VISTARA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
